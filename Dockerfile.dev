FROM mcr.microsoft.com/dotnet/sdk:10.0

WORKDIR /app

# Copia apenas arquivos de projeto para restaurar dependências (cache layer)
COPY troca-moedas.sln ./
COPY src/TrocaMoedas/TrocaMoedas.csproj src/TrocaMoedas/
RUN dotnet restore src/TrocaMoedas/TrocaMoedas.csproj

# Copia todo o código-fonte
COPY src/ src/

ENTRYPOINT ["dotnet", "run", "--project", "src/TrocaMoedas"]
