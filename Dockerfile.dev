FROM mcr.microsoft.com/dotnet/sdk:10.0

WORKDIR /app

# Copia apenas arquivos de projeto para restaurar dependências (cache layer)
COPY currency-converter-dotnet.sln ./
COPY src/CurrencyConverter/CurrencyConverter.csproj src/CurrencyConverter/
RUN dotnet restore src/CurrencyConverter/CurrencyConverter.csproj

# Copia todo o código-fonte
COPY src/ src/

ENTRYPOINT ["dotnet", "run", "--project", "src/CurrencyConverter"]
